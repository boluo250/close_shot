page {
  background: #000000;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 0 32rpx 56rpx;
  box-sizing: border-box;
}

.safe-top {
  height: 96rpx;
}

.header-card {
  margin-bottom: 32rpx;
  border-radius: 40rpx;
  padding: 36rpx 28rpx;
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.35);
}

.profile-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
}

.profile-main {
  margin-left: 26rpx;
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 48rpx;
  line-height: 56rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 44rpx;
}

.tag-green {
  color: #000000;
  background: #22c55e;
  font-weight: 700;
}

.tag-dark {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.1);
}

.stats-card {
  margin-top: 8rpx;
  border-radius: 40rpx;
  padding: 34rpx 18rpx;
  display: flex;
  align-items: stretch;
  background: linear-gradient(150deg, #151515 0%, #0d0d0d 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 22rpx 44rpx rgba(0, 0, 0, 0.42);
}

.stats-item {
  flex: 1;
  text-align: center;
  padding: 6rpx 8rpx;
}

.stats-title {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8a;
}

.stats-value {
  margin-top: 10rpx;
  font-size: 72rpx;
  line-height: 78rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: "DIN Alternate", "Bebas Neue", Arial, sans-serif;
  letter-spacing: 1rpx;
}

.amount {
  color: #ffffff;
}

.stats-action {
  margin-top: 16rpx;
  display: inline-block;
  min-width: 132rpx;
  padding: 0 18rpx;
  height: 50rpx;
  line-height: 50rpx;
  border-radius: 25rpx;
  font-size: 22rpx;
  color: #cfcfcf;
  background: rgba(255, 255, 255, 0.08);
}

.stats-action-green {
  color: #0c0c0c;
  background: #22c55e;
  font-weight: 700;
}

.stats-divider {
  width: 1rpx;
  margin: 16rpx 0;
  background: rgba(255, 255, 255, 0.09);
}

.list-card {
  margin-top: 34rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.list-item {
  min-height: 130rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-hover {
  background: rgba(255, 255, 255, 0.1);
}

.list-left {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.list-title {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #f4f4f4;
  margin-bottom: 8rpx;
}

.list-desc {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #7f7f7f;
}

.list-arrow {
  width: 34rpx;
  text-align: right;
  font-size: 36rpx;
  line-height: 36rpx;
  color: #5e5e5e;
}

.footer-logout {
  margin-top: 58rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666666;
}