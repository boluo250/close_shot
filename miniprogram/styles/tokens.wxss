/* Close Shot Design Tokens（统一 UI 入口） */
:root,
page {
  /* 参考图风格：浅灰底 + 大圆角卡片 + 荧光黄绿点缀 */
  --cs-color-bg: #f7f7f8;
  --cs-color-surface: #ffffff;
  --cs-color-surface-2: #f3f4f6;
  --cs-color-text: #111827;
  --cs-color-text-2: #374151;
  --cs-color-text-3: #6b7280;
  --cs-color-muted: #8a8f98;
  --cs-color-border: #eef0f3;
  --cs-color-primary: #bfe84a;
  --cs-color-primary-press: #a8d63c;
  --cs-color-success: #22c55e;
  --cs-color-danger: #ef4444;

  /* 主按钮渐变（用于“联系摄影师”等关键 CTA） */
  --cs-gradient-primary: linear-gradient(135deg, #bfe84a 0%, #d9ff6a 55%, #bfe84a 100%);
  --cs-gradient-primary-press: linear-gradient(135deg, #a8d63c 0%, #c9f35f 55%, #a8d63c 100%);

  /* TabBar */
  --cs-tabbar-bg: #ffffff;
  --cs-tabbar-border: #eef0f3;

  --cs-radius-md: 18rpx;
  --cs-radius-lg: 28rpx;
  --cs-space-3: 12rpx;
  --cs-space-4: 16rpx;
  --cs-space-5: 20rpx;
  --cs-space-6: 24rpx;
  --cs-font-sm: 24rpx;
  --cs-font-md: 28rpx;
  --cs-font-lg: 32rpx;

  --cs-shadow-card: 0 10rpx 30rpx rgba(17, 24, 39, 0.06);
  --cs-shadow-glow: 0 0 18rpx rgba(191, 232, 74, 0.35);
}

/* 主题：汽水音乐（暗色霓虹） */
.cs-theme-soda {
  --cs-color-bg: #0b0d12;
  --cs-color-surface: rgba(255, 255, 255, 0.06);
  --cs-color-surface-2: rgba(255, 255, 255, 0.10);
  --cs-color-text: #f8fafc;
  --cs-color-text-2: rgba(248, 250, 252, 0.86);
  --cs-color-text-3: rgba(248, 250, 252, 0.70);
  --cs-color-muted: rgba(148, 163, 184, 0.85);
  --cs-color-border: rgba(255, 255, 255, 0.12);
  --cs-color-primary: #39ff88;
  --cs-color-primary-press: #22e676;
  --cs-color-success: #39ff88;
  --cs-color-danger: #ff4d6d;

  --cs-gradient-primary: linear-gradient(135deg, #39ff88 0%, #00f0ff 100%);
  --cs-gradient-primary-press: linear-gradient(135deg, #22e676 0%, #00d7e6 100%);

  --cs-tabbar-bg: #0b0d12;
  --cs-tabbar-border: rgba(255, 255, 255, 0.12);

  --cs-shadow-card: 0 14rpx 40rpx rgba(0, 0, 0, 0.45);
  --cs-shadow-glow: 0 0 22rpx rgba(57, 255, 136, 0.40);
}

.cs-theme-classic {
  /* classic 是默认值，这里留空方便统一挂 class */
}

.cs-page {
  padding: var(--cs-space-5);
}

.cs-card {
  background: var(--cs-color-surface);
  border-radius: var(--cs-radius-lg);
  padding: var(--cs-space-6);
  box-shadow: var(--cs-shadow-card);
}

.cs-muted {
  color: var(--cs-color-muted);
  font-size: var(--cs-font-sm);
}

.cs-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cs-divider {
  border-bottom: 1px solid var(--cs-color-border);
}

/* 按钮：图里是“胶囊 + 柔和阴影/描边” */
.cs-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1px solid var(--cs-color-border);
  color: var(--cs-color-text);
  font-size: var(--cs-font-sm);
}

.cs-btn-primary {
  background: var(--cs-color-primary);
  border-color: var(--cs-color-primary);
}

