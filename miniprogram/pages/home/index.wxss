.home {
  min-height: 100vh;
  background: var(--cs-color-bg);
}

.home-content {
  min-height: 100vh;
  padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 8rpx 22rpx calc(8rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(11, 13, 18, 0) 0%, rgba(11, 13, 18, 0.72) 42%, rgba(11, 13, 18, 0.92) 100%);
}

.bottom-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 5rpx;
  border-radius: 999rpx;
  background: var(--cs-color-surface-2);
  border: 1rpx solid var(--cs-color-border);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.28);
}

.bottom-nav-item {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  border-radius: 999rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0;
  color: var(--cs-color-muted);
  transition: all 160ms ease;
}

.bottom-nav-text {
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
}

.bottom-nav-item.active {
  color: #0b0d12;
  background:  linear-gradient(135deg, #39ff88 0%, #00f0ff 100%);
  box-shadow: inset 0 0 0 1rpx rgba(134, 239, 172, 0.5);
}

.cs-theme-classic .bottom-nav {
  background: linear-gradient(180deg, rgba(248, 250, 252, 0) 0%, rgba(248, 250, 252, 0.88) 35%, rgba(248, 250, 252, 0.96) 100%);
}

.cs-theme-classic .bottom-nav-inner {
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(17, 24, 39, 0.08);
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.14);
}

.cs-theme-classic .bottom-nav-item {
  color: rgba(17, 24, 39, 0.58);
}

.cs-theme-classic .bottom-nav-item.active {
  color: #166534;
  background: rgba(34, 197, 94, 0.16);
  box-shadow: inset 0 0 0 1rpx rgba(34, 197, 94, 0.34);
}

