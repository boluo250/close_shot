.home {
  min-height: 100vh;
  background: var(--cs-color-bg);
}

.home-content {
  min-height: 100vh;
  padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 8rpx 22rpx calc(8rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(11, 13, 18, 0) 0%, rgba(11, 13, 18, 0.72) 42%, rgba(11, 13, 18, 0.92) 100%);
}

.bottom-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 5rpx;
  border-radius: 999rpx;
  background: var(--cs-color-surface-2);
  border: 1rpx solid var(--cs-color-border);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.28);
}

.bottom-nav-item {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0;
  color: var(--cs-color-muted);
  transition: all 160ms ease;
}

.bottom-nav-text {
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
}

.bottom-nav-item.active {
  color: #0b0d12;
  background:  linear-gradient(135deg, #39ff88 0%, #00f0ff 100%);
  box-shadow: inset 0 0 0 1rpx rgba(134, 239, 172, 0.5);
}
