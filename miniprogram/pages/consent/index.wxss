.consent-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(191, 232, 74, 0.22), transparent 36%),
    linear-gradient(180deg, #f8faf5 0%, #ffffff 48%, #f5f7fb 100%);
}

.consent-hero {
  padding: 48rpx 8rpx 28rpx;
}

.consent-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(191, 232, 74, 0.22);
  color: #5a7a00;
  font-size: 22rpx;
  font-weight: 600;
}

.consent-title {
  margin-top: 28rpx;
  font-size: 46rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.consent-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #6b7280;
}

.consent-card {
  margin-top: 12rpx;
  padding: 28rpx 24rpx 30rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.08);
}

.doc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(17, 24, 39, 0.06);
}

.doc-row:last-of-type {
  border-bottom: none;
}

.doc-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.doc-link {
  font-size: 24rpx;
  color: #2563eb;
}

.agree-box {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(17, 24, 39, 0.04);
}

.agree-check {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(17, 24, 39, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  color: transparent;
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.agree-check.checked {
  background: #bfe84a;
  border-color: #bfe84a;
  color: #111827;
}

.agree-copy {
  font-size: 25rpx;
  line-height: 1.8;
  color: #374151;
}

.enter-btn {
  margin-top: 28rpx;
  width: 100%;
  border: none;
  border-radius: 999rpx;
  padding: 22rpx 0;
  background: #bfe84a;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.enter-btn.disabled {
  opacity: 0.45;
}
