/* ====== 全局 ====== */
.cs-page {
  padding: 16rpx 0;
  background: var(--cs-color-bg);
  min-height: 100vh;
}

.cs-card {
  background: var(--cs-color-surface);
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: var(--cs-shadow-card);
}

.cs-muted {
  color: var(--cs-color-muted);
  font-size: 24rpx;
}

/* ====== 头部 ====== */
.p-header {
  display: flex;
  gap: 20rpx;
}

.p-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: var(--cs-color-border);
  flex-shrink: 0;
}

.p-main {
  flex: 1;
  min-width: 0;
}

.p-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.p-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--cs-color-text);
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-btn {
  background: var(--cs-color-surface-2);
  color: var(--cs-color-text-2);
  border: 1rpx solid var(--cs-color-border);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.fav-btn.fav-active {
  background: var(--cs-gradient-primary);
  border-color: transparent;
  color: #0b0d12;
  box-shadow: var(--cs-shadow-glow);
}

.fav-btn::after {
  border: none;
}

.p-bio {
  margin-top: 10rpx;
  color: var(--cs-color-text-3);
  font-size: 26rpx;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* ====== 标签/状态 ====== */
.meta-strip {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: var(--cs-color-surface-2);
  border: 1rpx solid var(--cs-color-border);
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: nowrap;
  white-space: nowrap;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
}

.dot-active {
  background: var(--cs-color-success);
  box-shadow: var(--cs-shadow-glow);
}

.dot-inactive {
  background: var(--cs-color-border);
}

.meta-text {
  font-size: 24rpx;
  color: var(--cs-color-text-2);
  line-height: 1.1;
}

.meta-sep {
  color: var(--cs-color-border);
  font-size: 24rpx;
}

.meta-active {
  color: var(--cs-color-success);
  font-weight: 600;
}

.meta-inactive {
  color: var(--cs-color-muted);
}

/* ====== Section 通用 ====== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cs-color-text);
}

.section-count {
  font-size: 24rpx;
  color: var(--cs-color-muted);
}

.empty-hint {
  text-align: center;
  padding: 32rpx 0;
  color: var(--cs-color-muted);
  font-size: 26rpx;
}

/* ====== 作品集 - 三列画廊 ====== */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.gallery-item {
  aspect-ratio: 1;
  overflow: hidden;
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--cs-color-surface-2);
}

/* ====== 服务套餐 ====== */
.pkg-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--cs-color-border);
}

.pkg-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.pkg-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pkg-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--cs-color-text);
}

.pkg-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--cs-color-text);
}

.pkg-detail {
  margin-top: 6rpx;
}

.pkg-duration {
  font-size: 24rpx;
  color: var(--cs-color-muted);
}

.pkg-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--cs-color-text-3);
  line-height: 1.5;
}

/* ====== 报价明细 ====== */
.rate-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--cs-color-border);
}

.rate-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rate-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rate-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rate-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--cs-color-text);
}

.rate-mode {
  font-size: 22rpx;
  color: var(--cs-color-muted);
  background: var(--cs-color-surface-2);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.rate-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--cs-color-text);
}

.rate-unit {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--cs-color-muted);
}

/* ====== 服务套餐与报价（统一列表展示） ====== */
.offer-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--cs-color-border);
}

.offer-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.offer-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.offer-left {
  flex: 1;
  min-width: 0;
}

.offer-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.offer-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--cs-color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 440rpx;
}

.offer-badge {
  font-size: 22rpx;
  color: var(--cs-color-muted);
  background: var(--cs-color-surface-2);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.offer-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--cs-color-muted);
}

.offer-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--cs-color-text);
  flex-shrink: 0;
}

.offer-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--cs-color-text-3);
  line-height: 1.5;
}

/* ====== 装备信息 ====== */
.equip-group {
  margin-top: 12rpx;
}

.equip-group:first-child {
  margin-top: 0;
}

.equip-label {
  font-size: 24rpx;
  color: var(--cs-color-text-3);
  margin-bottom: 8rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--cs-color-surface-2);
  color: var(--cs-color-text-2);
  font-size: 24rpx;
}

/* ====== 评价 ====== */
.review-card {
  padding-top: 20rpx;
  display: flex;
  gap: 14rpx;
}

.review-card:first-of-type {
  padding-top: 0;
}

.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--cs-color-surface-2);
  flex-shrink: 0;
}

.review-main {
  flex: 1;
  min-width: 0;
}

.review-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10rpx;
}

.review-name {
  font-weight: 600;
  color: var(--cs-color-text);
  font-size: 26rpx;
}

.review-date {
  color: var(--cs-color-muted);
  font-size: 22rpx;
}

.review-stars {
  padding-top: 4rpx;
  font-size: 22rpx;
}

.review-content {
  padding-top: 6rpx;
  color: var(--cs-color-text-2);
  font-size: 26rpx;
  line-height: 1.6;
}

/* ====== 底部联系按钮 ====== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--cs-color-surface);
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.12);
  z-index: 100;
}

.contact-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--cs-gradient-primary);
  color: #0b0d12;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.contact-btn::after {
  border: none;
}

.contact-btn:active {
  background: var(--cs-gradient-primary-press);
  transform: translateY(1rpx);
}
