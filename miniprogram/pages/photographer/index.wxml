<view class="cs-page {{themeClass}}">
  <!-- 头部：头像 + 名字 + 简介 -->
  <view class="cs-card">
    <view class="p-header">
      <image
        class="p-avatar"
        mode="aspectFill"
        src="{{p.avatar_url || ''}}"
        style="{{p.avatar_url ? '' : 'background:#eef0f3;'}}"
        bindtap="previewAvatar"
      />
      <view class="p-main">
        <view class="p-name-row">
          <text class="p-name">{{p.display_name || ('摄影师 #' + p.id)}}</text>
          <button class="fav-btn {{fav ? 'fav-active' : ''}}" size="mini" bindtap="toggleFav">
            {{fav ? '已收藏' : '收藏'}}
          </button>
        </view>

        <view class="meta-strip" wx:if="{{distanceText}}">
          <text class="meta-text">{{distanceText}}</text>
        </view>
        <view class="p-bio-block" wx:if="{{p.bio}}">
          <view class="p-bio {{bioExpanded ? 'p-bio-expanded' : 'p-bio-collapsed'}}">{{p.bio}}</view>
          <view wx:if="{{bioCanExpand && !bioExpanded}}" class="p-bio-fade"></view>
          <view wx:if="{{bioCanExpand}}" class="p-bio-toggle" bindtap="toggleBioExpanded">
            <text class="p-bio-toggle-text">{{bioExpanded ? '收起' : '展开完整描述'}}</text>
          </view>
          <view class="p-bio-measure">
            <view id="p-bio-collapsed" class="p-bio p-bio-collapsed p-bio-measure-text">{{p.bio}}</view>
            <view id="p-bio-full" class="p-bio p-bio-expanded p-bio-measure-text">{{p.bio}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 作品集 - 三列瀑布流 -->
  <view class="cs-card" wx:if="{{portfolio.length > 0}}">
    <view class="section-header">
      <text class="section-title">作品集</text>
      <text class="section-count">{{portfolio.length}} 张</text>
    </view>
    <view class="gallery-grid">
      <view
        wx:for="{{portfolio}}"
        wx:key="id"
        class="gallery-item"
        bindtap="previewPortfolio"
        data-idx="{{index}}"
      >
        <image class="gallery-img" mode="aspectFill" src="{{item.image_url}}" />
      </view>
    </view>
  </view>

  <!-- 服务套餐 + 报价明细（合并展示为一个列表） -->
  <view class="cs-card" wx:if="{{offerings.length > 0}}">
    <view class="section-header">
      <text class="section-title">服务套餐与报价</text>
    </view>

    <view wx:for="{{offerings}}" wx:key="key" class="offer-item">
      <view class="offer-row">
        <view class="offer-left">
          <view class="offer-title-row">
            <text class="offer-name">{{item.name}}</text>
            <text class="offer-badge">{{item.badge}}</text>
          </view>
          <view class="offer-meta" wx:if="{{item.meta}}">{{item.meta}}</view>
        </view>
        <text class="offer-price">¥{{item.price_yuan}}</text>
      </view>
      <view class="offer-desc" wx:if="{{item.description}}">{{item.description}}</view>
    </view>
  </view>

  <!-- 装备信息 - 直接展示，不折叠 -->
  <view class="cs-card" wx:if="{{hasEquipment}}">
    <view class="section-header">
      <text class="section-title">装备信息</text>
    </view>
    <view wx:if="{{equipmentList.length > 0}}" class="equip-group">
      <view class="equip-label">相机 / 镜头</view>
      <view class="pill-row">
        <view wx:for="{{equipmentList}}" wx:key="*this" class="pill">{{item}}</view>
      </view>
    </view>
    <view wx:if="{{droneModels.length > 0}}" class="equip-group">
      <view class="equip-label">无人机</view>
      <view class="pill-row">
        <view wx:for="{{droneModels}}" wx:key="*this" class="pill">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 用户评价：仅展示后台审核通过的评价 -->
  <view class="cs-card" wx:if="{{reviews.length > 0}}">
    <view class="section-header">
      <text class="section-title">用户评价</text>
      <text class="section-count">{{reviews.length}} 条</text>
    </view>
    <view wx:for="{{reviews}}" wx:key="id" class="review-card">
      <image class="review-avatar" mode="aspectFill" src="{{item.user_avatar_url || ''}}" />
      <view class="review-main">
        <view class="review-head">
          <text class="review-name">{{item.userName}}</text>
          <text class="review-date">{{item.dateText}}</text>
        </view>
        <view class="review-stars">{{item.stars}}</view>
        <view wx:if="{{item.content}}" class="review-content">{{item.content}}</view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button wx:if="{{isOwnerPhotographer}}" class="contact-btn" bindtap="goEditProfile">编辑我的主页</button>
    <view wx:else class="bottom-bar-actions">
      <button class="contact-btn appointment-soda-btn" bindtap="goCreateAppointment">发起预约</button>
    </view>
  </view>

  <!-- 底部安全区占位 -->
  <view style="height: 140rpx;"></view>
</view>
