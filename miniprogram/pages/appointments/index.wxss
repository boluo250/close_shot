.appointments-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 40rpx;
  background:
    radial-gradient(circle at top right, rgba(191, 232, 74, 0.16), transparent 32%),
    linear-gradient(180deg, #090b10 0%, #11151d 100%);
  box-sizing: border-box;
}

.appointments-hero {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03)),
    linear-gradient(135deg, rgba(191, 232, 74, 0.12), rgba(141, 223, 79, 0.02));
  border: 1rpx solid rgba(191, 232, 74, 0.16);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.28);
}

.appointments-hero-main {
  flex: 1;
}

.appointments-hero-eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #90a4bc;
}

.appointments-hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
}

.appointments-hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #c8d1de;
}

.appointments-hero-meter {
  min-width: 150rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(7, 10, 14, 0.72);
  border: 1rpx solid rgba(191, 232, 74, 0.18);
  text-align: right;
}

.appointments-hero-meter-label {
  display: block;
  font-size: 22rpx;
  color: #90a4bc;
}

.appointments-hero-meter-value {
  display: block;
  margin-top: 12rpx;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 800;
  color: #bfe84a;
}

.appointments-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.appointments-tab {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  color: #dbe4f1;
  font-size: 28rpx;
}

.appointments-tab::after {
  border: none;
}

.appointments-tab-active {
  background: linear-gradient(135deg, #bfe84a 0%, #8ddf4f 100%);
  color: #0b0d12;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(141, 223, 79, 0.22);
}

.appointments-tab-badge {
  min-width: 40rpx;
  padding: 0 12rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 999rpx;
  background: rgba(11, 13, 18, 0.18);
  text-align: center;
  font-size: 22rpx;
}

.appointments-dashboard {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
  overflow-x: auto;
}

.dashboard-card {
  flex: 1;
  min-width: 200rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e7edf5;
}

.dashboard-label {
  display: block;
  font-size: 22rpx;
  color: #90a4bc;
}

.dashboard-value {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
}

.dashboard-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #b3c0d3;
}

.appointments-alert {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(191, 232, 74, 0.1);
  border: 1rpx solid rgba(191, 232, 74, 0.18);
}

.appointments-alert-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #d4f46d;
}

.appointments-alert-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #d2d7e1;
}

.appointments-empty {
  margin-top: 120rpx;
  padding: 48rpx 36rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #d2d7e1;
  text-align: center;
}

.appointments-empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.appointments-empty-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.appointments-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.appointment-card {
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e5e7eb;
}

.appointment-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.appointment-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.appointment-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.appointment-status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.appointment-status-pending {
  background: rgba(251, 191, 36, 0.18);
  color: #fcd34d;
}

.appointment-status-accepted_pending_customer,
.appointment-status-confirmed,
.appointment-status-completed {
  background: rgba(34, 197, 94, 0.18);
  color: #86efac;
}

.appointment-status-rejected,
.appointment-status-cancelled {
  background: rgba(248, 113, 113, 0.16);
  color: #fca5a5;
}

.appointment-meta,
.appointment-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #cbd5e1;
}

.appointment-tip {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #bfe84a;
}

.appointment-actions {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.appointment-btn {
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.06);
  color: #f8fafc;
  font-size: 26rpx;
}

.appointment-btn::after {
  border: none;
}

.appointment-btn-primary {
  background: linear-gradient(135deg, #bfe84a 0%, #8ddf4f 100%);
  color: #0b0d12;
  font-weight: 700;
}
