<view class="cs-page appointment-create-page">
  <view class="create-card">
    <view class="create-title">预约 {{photographerName}}</view>
    <view class="create-desc">先提交时间、地点和人数，摄影师同意后还需你最终确认，确认后双方联系方式才会解锁。</view>
    <view class="create-subscribe-tip">提交时会申请“预约处理结果提醒”，方便你及时收到接单通知。</view>

    <view class="field">
      <text class="field-label">预约日期</text>
      <picker mode="date" value="{{form.date}}" bindchange="bindDateChange">
        <view class="field-picker">{{form.date}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">预约时间</text>
      <picker mode="time" value="{{form.time}}" bindchange="bindTimeChange">
        <view class="field-picker">{{form.time}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">套餐选择</text>
      <picker mode="selector" range="{{packageOptions}}" range-key="label" value="{{packageIndex}}" bindchange="bindPackageChange">
        <view class="field-picker">{{packageOptions[packageIndex].label}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label"><text class="field-required">*</text>拍摄地点</text>
      <view class="field-inline-actions">
        <input class="field-input field-input-location" maxlength="255" placeholder="必填，可手动填写，例如：上海静安寺 / 某咖啡馆" value="{{form.locationText}}" data-field="locationText" bindinput="bindInput" bindblur="bindInput" />
        <button class="field-action-btn" bindtap="pickLocation">地图选点</button>
      </view>
      <view class="field-help">建议填写到商圈、景点、街道或门店，方便摄影师判断是否可接单。</view>
    </view>

    <view class="contact-card">
      <view class="contact-title">你的联系方式</view>
      <view class="contact-desc">仅在你最终确认预约后展示给摄影师。填写一次后，下次发起预约会自动带入。</view>
      <view class="field">
        <text class="field-label">联系人称呼</text>
        <input class="field-input" maxlength="64" placeholder="例如：张先生 / Lucky" value="{{form.contactName}}" data-field="contactName" bindinput="bindInput" bindblur="bindInput" />
      </view>
      <view class="field">
        <text class="field-label">联系电话</text>
        <input class="field-input" type="text" maxlength="20" placeholder="手机号或方便联系的电话" value="{{form.contactPhone}}" data-field="contactPhone" bindinput="bindInput" bindblur="bindInput" />
      </view>
    </view>

    <view class="field">
      <text class="field-label">参与人数</text>
      <input class="field-input" type="number" maxlength="2" placeholder="默认 1 人" value="{{form.participantCount}}" data-field="participantCount" bindinput="bindInput" bindblur="bindInput" />
    </view>

    <view class="field">
      <text class="field-label">补充说明</text>
      <textarea class="field-textarea" maxlength="2000" placeholder="风格偏好、是否需要外景、特殊需求等" value="{{form.note}}" data-field="note" bindinput="bindInput"></textarea>
    </view>

    <view class="draft-card">
      <view class="draft-title">当前预约摘要</view>
      <view class="draft-row">时间：{{form.date}} {{form.time}}</view>
      <view class="draft-row">地点：{{form.locationText || '未填写'}}</view>
      <view class="draft-row">联系：{{form.contactName || '未填写称呼'}} · {{form.contactPhone || '未填写电话'}}</view>
      <view class="draft-row">人数：{{form.participantCount || '1'}} 人</view>
      <view class="draft-row">说明：{{form.note || '未填写'}}</view>
    </view>
  </view>

  <view class="create-footer">
    <button class="create-submit" loading="{{submitting}}" bindtap="submit">提交预约</button>
  </view>
</view>
