.appointment-create-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
  background: #0b0d12;
  box-sizing: border-box;
}

.create-card {
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.create-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.create-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.create-subscribe-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #d9f99d;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #cbd5e1;
}

.field-required {
  margin-right: 6rpx;
  color: #f97316;
}

.field-inline-actions {
  display: flex;
  gap: 14rpx;
  align-items: stretch;
}

.field-input,
.field-picker,
.field-textarea {
  display: block;
  width: 100%;
  min-height: 82rpx;
  line-height: 38rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #f8fafc;
  font-size: 28rpx;
}

.field-input-location {
  flex: 1;
}

.field-picker {
  min-height: 82rpx;
}

.field-textarea {
  min-height: 180rpx;
  line-height: 1.7;
}

.field-action-btn {
  flex-shrink: 0;
  min-width: 170rpx;
  min-height: 82rpx;
  padding: 0 26rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(191, 232, 74, 0.2);
  background: rgba(191, 232, 74, 0.1);
  color: #d9f99d;
  font-size: 26rpx;
  line-height: 82rpx;
}

.field-action-btn::after {
  border: none;
}

.field-help {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.contact-card {
  margin-top: 26rpx;
  padding: 22rpx 24rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(191, 232, 74, 0.14);
}

.contact-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.contact-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #aeb9c9;
}

.draft-card {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(191, 232, 74, 0.08);
  border: 1rpx solid rgba(191, 232, 74, 0.2);
}

.draft-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #d9f99d;
}

.draft-row {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #e5e7eb;
}

.create-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(11, 13, 18, 0.94);
  box-shadow: 0 -12rpx 30rpx rgba(0, 0, 0, 0.2);
}

.create-submit {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #bfe84a 0%, #8ddf4f 100%);
  color: #0b0d12;
  font-size: 30rpx;
  font-weight: 700;
  border: 0;
}

.create-submit::after {
  border: none;
}
