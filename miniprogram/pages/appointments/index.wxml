<view class="cs-page appointments-page">
  <view wx:if="{{loading}}" class="appointments-empty">加载中...</view>

  <view wx:elif="{{!items.length}}" class="appointments-empty">
    <text class="appointments-empty-title">还没有预约记录</text>
    <text class="appointments-empty-desc">
      {{mode === 'assigned' ? '新的预约会出现在这里，方便你接单和确认完成。' : '去摄影师详情页发起预约后，会在这里看到状态。'}}
    </text>
  </view>

  <view wx:else class="appointments-list">
    <view wx:for="{{items}}" wx:key="id" class="appointment-card">
      <view class="appointment-top">
        <view>
          <view class="appointment-name">{{item.counterpartyName}}</view>
          <view class="appointment-time">{{item.scheduledText}}</view>
        </view>
        <text class="appointment-status appointment-status-{{item.status}}">{{item.statusLabel}}</text>
      </view>

      <view class="appointment-meta">地点：{{item.location_text}}</view>
      <view wx:if="{{item.package_name}}" class="appointment-meta">套餐：{{item.package_name}}</view>
      <view wx:if="{{item.shooting_type}}" class="appointment-meta">类型：{{item.shooting_type}}</view>
      <view wx:if="{{item.note}}" class="appointment-note">备注：{{item.note}}</view>
      <view wx:if="{{item.response_note}}" class="appointment-note">反馈：{{item.response_note}}</view>
      <view wx:if="{{item.status === 'accepted_pending_customer' && mode === 'mine'}}" class="appointment-tip">
        摄影师已同意，等待你确认后解锁双方联系方式
      </view>
      <view wx:if="{{item.status === 'confirmed' && mode === 'mine' && item.photographer_completed_at}}" class="appointment-tip">
        摄影师已标记拍摄完成，进入详情确认后即可评价
      </view>

      <view class="appointment-actions">
        <button class="appointment-btn appointment-btn-primary" data-id="{{item.id}}" bindtap="goDetail">查看详情</button>
      </view>
    </view>
  </view>
</view>
