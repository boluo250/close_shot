.appointment-detail-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  background: #0b0d12;
  box-sizing: border-box;
}

.detail-empty {
  margin-top: 160rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.detail-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-card {
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.detail-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.detail-title {
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #ffffff;
}

.detail-status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.detail-status-pending {
  background: rgba(251, 191, 36, 0.18);
  color: #fcd34d;
}

.detail-status-accepted_pending_customer {
  background: rgba(191, 232, 74, 0.18);
  color: #d9f99d;
}

.detail-status-confirmed,
.detail-status-completed {
  background: rgba(34, 197, 94, 0.18);
  color: #86efac;
}

.detail-status-rejected,
.detail-status-cancelled {
  background: rgba(248, 113, 113, 0.16);
  color: #fca5a5;
}

.detail-row,
.detail-note {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #d7dee8;
}

.detail-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.detail-btn {
  min-width: 200rpx;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #f8fafc;
  font-size: 28rpx;
}

.detail-btn::after {
  border: none;
}

.detail-btn-primary {
  background: linear-gradient(135deg, #bfe84a 0%, #8ddf4f 100%);
  color: #0b0d12;
  font-weight: 700;
}
