/* ====== 全局 ====== */
.cs-page {
  padding: 0 24rpx 24rpx;
  background: var(--cs-color-bg);
  min-height: 100vh;
}

.cs-card {
  background: var(--cs-color-surface);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 16rpx;
  box-shadow: var(--cs-shadow-card);
}

.cs-muted {
  color: var(--cs-color-muted);
  font-size: 24rpx;
}

/* ====== 页面头部 ====== */
.page-header {
  padding: 40rpx 4rpx 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cs-color-text);
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--cs-color-muted);
  margin-top: 6rpx;
}

.theme-bar {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.overview-item {
  background: var(--cs-color-surface-2);
  border: 1rpx solid var(--cs-color-border);
  border-radius: 14rpx;
  padding: 16rpx;
}

.overview-label {
  font-size: 22rpx;
  color: var(--cs-color-muted);
}

.overview-value {
  font-size: 28rpx;
  color: var(--cs-color-text);
  font-weight: 600;
  margin-top: 6rpx;
}

/* ====== 卡片通用 ====== */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--cs-color-primary);
  color: #0b0d12;
  box-shadow: var(--cs-shadow-glow);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cs-theme-classic .step-badge {
  color: #111827;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cs-color-text);
}

.save-btn {
  background: var(--cs-color-primary);
  color: #0b0d12;
  box-shadow: var(--cs-shadow-glow);
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1.6;
}

.cs-theme-classic .save-btn {
  color: #111827;
}

.refresh-btn {
  background: var(--cs-color-surface-2);
  color: var(--cs-color-text-3);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1.6;
}

.cancel-btn {
  background: var(--cs-color-surface-2);
  color: var(--cs-color-text-3);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1.6;
}

.delete-btn {
  background: none;
  color: var(--cs-color-danger);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(239, 68, 68, 0.35);
  line-height: 1.6;
}

/* ====== 头像 ====== */
.profile-images {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.avatar-block {
  width: 160rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: var(--cs-color-surface-2);
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: var(--cs-color-surface-2);
  border: 2rpx dashed var(--cs-color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.placeholder-icon {
  font-size: 40rpx;
  color: var(--cs-color-muted);
  line-height: 1;
}

.placeholder-text {
  font-size: 22rpx;
  color: var(--cs-color-muted);
}

/* ====== 字段标签 ====== */
.field-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--cs-color-text-2);
  margin-bottom: 10rpx;
  margin-top: 8rpx;
}

.section-tip {
  font-size: 22rpx;
  color: var(--cs-color-muted);
  margin-bottom: 10rpx;
}

/* ====== 简介模板 ====== */
.bio-templates {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.bio-tpl {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--cs-color-surface-2);
  border: 1rpx solid var(--cs-color-border);
  font-size: 24rpx;
  color: var(--cs-color-text-3);
}

.bio-tpl.active {
  background: var(--cs-color-primary);
  color: #0b0d12;
  border-color: var(--cs-color-primary);
  box-shadow: var(--cs-shadow-glow);
}

.cs-theme-classic .bio-tpl.active {
  color: #111827;
}

.bio-input {
  width: 100%;
  min-height: 120rpx;
  background: var(--cs-color-surface-2);
  border: 1rpx solid var(--cs-color-border);
  border-radius: 14rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--cs-color-text);
  box-sizing: border-box;
}

/* ====== 设备清单 / 无人机编辑 ====== */
.equip-hint {
  font-size: 24rpx;
  color: var(--cs-color-muted);
  margin-bottom: 12rpx;
}

.equip-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.equip-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--cs-color-surface-2);
  color: var(--cs-color-text-2);
  font-size: 24rpx;
}

.equip-chip.drone-chip {
  background: rgba(57, 255, 136, 0.14);
  color: var(--cs-color-primary);
}

.chip-remove {
  font-size: 28rpx;
  color: var(--cs-color-muted);
  padding-left: 4rpx;
  line-height: 1;
}

.equip-add-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.equip-input {
  flex: 1;
  background: var(--cs-color-surface-2);
  border: 1rpx solid var(--cs-color-border);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  font-size: 26rpx;
  color: var(--cs-color-text);
}

.equip-add-btn {
  background: var(--cs-color-surface-2);
  color: var(--cs-color-text-2);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1.6;
  flex-shrink: 0;
}

/* ====== 作品上传 ====== */
.upload-hint {
  font-size: 24rpx;
  color: var(--cs-color-muted);
  margin-bottom: 16rpx;
}

.upload-hint.danger {
  color: var(--cs-color-danger);
}

.upload-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  background: var(--cs-color-surface-2);
  border: 2rpx dashed var(--cs-color-border);
  color: var(--cs-color-text-3);
  font-size: 28rpx;
  text-align: center;
}

.upload-btn[disabled] {
  opacity: 0.5;
}

.upload-result {
  font-size: 24rpx;
  color: var(--cs-color-success);
  margin-top: 10rpx;
}

/* ====== 作品网格 ====== */
.portfolio-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
}

.portfolio-cell {
  display: flex;
  flex-direction: column;
  width: calc((100% - 12rpx) / 2);
}

@media screen and (min-width: 768px) {
  .portfolio-cell {
    width: calc((100% - 24rpx) / 3);
  }
}

.portfolio-thumb {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  background: var(--cs-color-surface-2);
}

.portfolio-actions {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 4rpx 0;
}

.action-link {
  font-size: 22rpx;
  color: var(--cs-color-text-3);
}

.action-link.pinned {
  color: var(--cs-color-text);
  font-weight: 500;
}

.action-link.danger {
  color: var(--cs-color-danger);
}

.action-link.pending-text {
  color: var(--cs-color-muted);
}

.empty-hint {
  text-align: center;
  padding: 40rpx 0 16rpx;
  color: var(--cs-color-muted);
  font-size: 26rpx;
}

.submit-upload-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 12rpx calc(14rpx + env(safe-area-inset-bottom));
  background: var(--cs-color-surface);
  border-top: 1rpx solid var(--cs-color-border);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.12);
  z-index: 20;
}

.location-row,
.location-inline-row {
  display: grid;
  grid-template-columns: 2fr 1fr;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.location-text {
  font-size: 22rpx;
  color: var(--cs-color-muted);
  line-height: 1.4;
}

.location-refresh-btn {
  background: var(--cs-color-surface-2);
  color: var(--cs-color-text-2);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1.6;
  min-width: 280rpx;
  justify-self: end;
}

.submit-upload-bar .location-text {
  color: var(--cs-color-text-2);
}

.location-card {
  padding: 22rpx 24rpx;
}

.location-soda-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-pill {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  background: var(--cs-color-surface-2);
  border: 1rpx solid var(--cs-color-border);
}

.location-pill-coord {
  flex: 1.6;
}

.location-pill-key {
  font-size: 22rpx;
  color: var(--cs-color-muted);
  flex-shrink: 0;
}

.location-pill-value {
  font-size: 24rpx;
  color: var(--cs-color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-refresh-soda-btn {
  min-width: 188rpx;
  padding: 10rpx 30rpx;
  background: var(--cs-color-primary);
  color: #0b0d12;
  border: none;
  box-shadow: var(--cs-shadow-glow);
}

.cs-theme-classic .location-refresh-soda-btn {
  color: #111827;
}

.submit-upload-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  background: var(--cs-color-primary);
  color: #0b0d12;
  box-shadow: var(--cs-shadow-glow);
}

.submit-upload-btn[disabled] {
  opacity: 0.45;
}

/* ====== 预设套餐 ====== */
.preset-section {
  text-align: center;
}

.preset-hint {
  font-size: 24rpx;
  color: var(--cs-color-muted);
  margin-bottom: 16rpx;
}

.preset-list {
  display: flex;
  gap: 12rpx;
}

.preset-card {
  flex: 1;
  background: var(--cs-color-surface-2);
  border: 1rpx solid var(--cs-color-border);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.preset-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--cs-color-text);
}

.preset-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--cs-color-text);
  margin-top: 8rpx;
}

.preset-desc {
  font-size: 22rpx;
  color: var(--cs-color-muted);
  margin-top: 6rpx;
}

.preset-or {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0;
}

.or-line {
  flex: 1;
  height: 1rpx;
  background: var(--cs-color-border);
}

.or-text {
  font-size: 24rpx;
  color: var(--cs-color-muted);
}

.text-btn {
  background: none;
  border: none;
  color: var(--cs-color-text-3);
  font-size: 26rpx;
  text-decoration: underline;
  padding: 0;
}

/* ====== 套餐编辑卡片 ====== */
.pkg-section-head {
  margin-top: 18rpx;
}

.pkg-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cs-color-text);
}

.pkg-section-desc {
  font-size: 22rpx;
  color: var(--cs-color-muted);
  margin-top: 6rpx;
}

.pkg-edit-card {
  background: var(--cs-color-surface-2);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.pkg-summary-list {
  margin-top: 14rpx;
}

.pkg-summary-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.pkg-summary-line:last-child {
  border-bottom: none;
}

.pkg-summary-main {
  flex: 1;
  min-width: 0;
}

.pkg-summary-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pkg-summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cs-color-text);
}

.pkg-summary-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(191, 232, 74, 0.95);
  background: rgba(191, 232, 74, 0.12);
  border: 1rpx solid rgba(191, 232, 74, 0.24);
}

.pkg-summary-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--cs-color-muted);
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pkg-inline-delete {
  flex-shrink: 0;
  min-width: 116rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 107, 129, 0.18);
  background: rgba(255, 107, 129, 0.06);
  font-size: 26rpx;
  color: #ff6b81;
}

/* ====== 新增套餐 ====== */
.new-pkg-section {
  margin-top: 12rpx;
}

.divider {
  height: 1rpx;
  background: var(--cs-color-border);
  margin: 16rpx 0;
}

.new-pkg-form {
  margin-top: 16rpx;
}

.input {
  height: 84rpx;
  padding: 0 18rpx;
  font-size: 28rpx;
  color: var(--cs-color-text);
  width: 100%;
  box-sizing: border-box;
}

.pkg-form-input {
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
}

.textarea-sm {
  width: 100%;
  min-height: 100rpx;
  padding: 14rpx;
  font-size: 26rpx;
  color: var(--cs-color-text);
  margin-top: 10rpx;
  box-sizing: border-box;
}

.pkg-form-textarea {
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
}

.pkg-placeholder {
  color: rgba(255, 255, 255, 0.34);
}

.row-2 {
  display: flex;
  gap: 12rpx;
}

.flex-1 {
  flex: 1;
}

.row-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  margin-top: 14rpx;
}

/* ====== 档期管理 ====== */
.expand-text {
  font-size: 24rpx;
  color: var(--cs-color-muted);
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.nav-btn {
  background: var(--cs-color-surface-2);
  color: var(--cs-color-text-3);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1.6;
}

.month-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cs-color-text);
  min-width: 140rpx;
  text-align: center;
}

.cs-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 24rpx;
  color: var(--cs-color-muted);
  margin-top: 8rpx;
}

.cs-calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 8rpx;
}

.cs-day {
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--cs-color-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cs-color-text-2);
  font-size: 26rpx;
}

.cs-day.busy {
  background: rgba(245, 158, 11, 0.22);
  color: #fbbf24;
}

.cs-day.blocked {
  background: rgba(255, 77, 109, 0.18);
  color: var(--cs-color-danger);
}

.cs-legend {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.cs-legend-item {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--cs-color-surface-2);
  color: var(--cs-color-text-3);
}

.cs-legend-item.busy {
  background: rgba(245, 158, 11, 0.22);
  color: #fbbf24;
}

.cs-legend-item.blocked {
  background: rgba(255, 77, 109, 0.18);
  color: var(--cs-color-danger);
}
