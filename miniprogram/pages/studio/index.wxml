<view class="cs-page">
  <view class="cs-card">
    <view><b>摄影师工作台（MVP）</b></view>
    <view class="cs-muted" style="padding-top: 8rpx;">
      用后台账号登录（/auth/login），然后可上传作品并写入 /studio/portfolio。
    </view>

    <view style="height: 16rpx;"></view>
    <view wx:if="{{!token}}">
      <view style="display:flex; gap: 12rpx;">
        <input class="input" placeholder="用户名" value="{{username}}" bindinput="onUser" />
        <input class="input" placeholder="密码" password value="{{password}}" bindinput="onPass" />
      </view>
      <button class="cs-btn cs-btn-primary" style="margin-top: 12rpx;" bindtap="login">登录</button>
    </view>

    <view wx:else>
      <view class="cs-muted">已登录</view>
      <button class="cs-btn" style="margin-top: 12rpx;" bindtap="logout">退出</button>
    </view>
  </view>

  <view style="height: 16rpx;"></view>

  <view class="cs-card">
    <view class="cs-row">
      <view><b>上传作品</b></view>
      <button class="cs-btn" size="mini" bindtap="refresh">刷新列表</button>
    </view>
    <view style="padding-top: 12rpx;">
      <input class="input" placeholder="标题（可选）" value="{{form.title}}" bindinput="onTitle" />
      <input class="input" style="margin-top: 10rpx;" placeholder="标签（逗号）" value="{{form.tags}}" bindinput="onTags" />
    </view>
    <button class="cs-btn cs-btn-primary" style="margin-top: 12rpx;" bindtap="chooseAndUpload" disabled="{{!token || uploading}}">
      {{uploading ? '上传中...' : '选择图片并上传'}}
    </button>
    <view wx:if="{{lastUrl}}" class="cs-muted" style="padding-top: 10rpx;">
      最新图片：{{lastUrl}}
    </view>
  </view>

  <view style="height: 16rpx;"></view>

  <view class="cs-card">
    <view><b>作品列表</b></view>
    <view wx:if="{{loading}}" class="cs-muted" style="padding-top: 12rpx;">加载中...</view>
    <view wx:for="{{items}}" wx:key="id" style="padding-top: 12rpx;">
      <image mode="aspectFill" src="{{item.image_url}}" style="width:100%; height: 280rpx; border-radius: 12rpx; background:#eee;" />
      <view class="cs-muted" style="padding-top: 6rpx;">#{{item.id}} {{item.title || ''}} {{item.tags}}</view>
    </view>
    <view wx:if="{{!loading && items.length===0}}" class="cs-muted" style="padding-top: 12rpx;">暂无</view>
  </view>
</view>

