<view class="cs-page {{themeClass}}">
  <!-- 顶部标题 -->
  <view class="page-header">
    <view class="page-title">摄影师工作台</view>
    <view class="page-subtitle">清晰查看已上传内容，并快速修改</view>
    <view wx:if="{{checkingIdentity}}" class="cs-muted" style="padding-top: 12rpx;">身份校验中...</view>
    <view wx:if="{{pendingReviewStatus === 'pending'}}" class="upload-hint" style="margin-top: 12rpx;">
      修改审核中：当前工作台展示的是待审核版本，线上页面仍保留旧版，审核通过后才会更新。
    </view>
    <view wx:if="{{pendingReviewStatus === 'rejected' && pendingRejectReason}}" class="upload-hint danger" style="margin-top: 12rpx;">
      上次修改未通过：{{pendingRejectReason}}
    </view>
    <view class="theme-bar">
      <theme-switch value="{{theme}}" bind:change="onThemeChange" />
    </view>
  </view>

  <view class="cs-card" wx:if="{{authorized}}">
    <view class="card-title">内容概览</view>
    <view class="overview-grid">
      <view class="overview-item">
        <view class="overview-label">头像</view>
        <view class="overview-value">{{profile.avatar_url ? '已上传' : '未上传'}}</view>
      </view>
      <view class="overview-item">
        <view class="overview-label">简介</view>
        <view class="overview-value">{{profile.bio ? '已填写' : '未填写'}}</view>
      </view>
      <view class="overview-item">
        <view class="overview-label">作品</view>
        <view class="overview-value">{{items.length}} 张</view>
      </view>
      <view class="overview-item">
        <view class="overview-label">套餐</view>
        <view class="overview-value">{{packages.length}} 个</view>
      </view>
    </view>
  </view>

  <!-- ========== STEP 1: 基础资料（必填核心） ========== -->
  <view class="cs-card" wx:if="{{authorized}}">
    <view class="card-header">
      <view class="card-title-row">
        <view class="step-badge">1</view>
        <text class="card-title">基础资料（可编辑）</text>
      </view>
      <button class="save-btn" size="mini" bindtap="saveProfile">保存草稿</button>
    </view>

    <!-- 头像 -->
    <view class="profile-images">
      <view class="avatar-block" bindtap="chooseProfileImage" data-type="avatar">
        <image wx:if="{{profile.avatar_url}}" class="avatar-img" mode="aspectFill" src="{{profile.avatar_url}}" />
        <view wx:else class="avatar-placeholder">
          <text class="placeholder-icon">+</text>
          <text class="placeholder-text">上传头像</text>
        </view>
      </view>
    </view>

    <view class="field-label">摄影师姓名</view>
    <view class="section-tip">会展示在你的摄影师主页和列表卡片里</view>
    <input
      class="bio-input"
      placeholder="请输入展示给客户看的姓名"
      value="{{profile.display_name}}"
      bindinput="onDisplayName"
      maxlength="20"
    />

    <!-- 简介：模板 + 输入 -->
    <view class="field-label">个人简介</view>
    <view class="section-tip">当前状态：{{profile.bio ? '已填写，可继续修改' : '未填写，建议补充'}}</view>
    <view wx:if="{{profileDraftSaved}}" class="upload-hint" style="margin-bottom: 10rpx;">
      已保存资料草稿，点击底部按钮后统一提交审核
    </view>
    <view class="bio-templates">
      <view
        wx:for="{{bioTemplates}}"
        wx:key="item"
        class="bio-tpl {{profile.bio === item ? 'active' : ''}}"
        data-tpl="{{item}}"
        bindtap="useBioTemplate"
      >{{item}}</view>
    </view>
    <textarea
      class="bio-input"
      placeholder="用一句话介绍你的服务特点..."
      value="{{profile.bio}}"
      bindinput="onBio"
      maxlength="200"
    ></textarea>

    <!-- 设备清单 -->
    <view class="field-label" style="margin-top: 20rpx;">设备清单</view>
    <view class="equip-hint">添加你的相机、镜头等设备，让客户了解你的装备</view>
    <view class="equip-chips">
      <view wx:for="{{equipmentItems}}" wx:key="*this" class="equip-chip">
        <text>{{item}}</text>
        <text class="chip-remove" data-index="{{index}}" bindtap="removeEquipment">×</text>
      </view>
    </view>
    <view class="equip-add-row">
      <input class="equip-input" placeholder="输入设备型号，如 Sony A7M4" value="{{newEquipment}}" bindinput="onNewEquipment" bindconfirm="addEquipment" />
      <button class="equip-add-btn" size="mini" bindtap="addEquipment">添加</button>
    </view>

    <!-- 无人机型号 -->
    <view class="field-label" style="margin-top: 20rpx;">无人机（选填）</view>
    <view class="equip-chips">
      <view wx:for="{{droneItems}}" wx:key="*this" class="equip-chip drone-chip">
        <text>{{item}}</text>
        <text class="chip-remove" data-index="{{index}}" bindtap="removeDrone">×</text>
      </view>
    </view>
    <view class="equip-add-row">
      <input class="equip-input" placeholder="输入无人机型号，如 DJI Air 3" value="{{newDrone}}" bindinput="onNewDrone" bindconfirm="addDrone" />
      <button class="equip-add-btn" size="mini" bindtap="addDrone">添加</button>
    </view>

  </view>

  <!-- ========== STEP 2: 作品上传（极简） ========== -->
  <view class="cs-card" wx:if="{{authorized}}">
    <view class="card-header">
      <view class="card-title-row">
        <view class="step-badge">2</view>
        <text class="card-title">作品管理（可编辑）</text>
      </view>
      <button class="refresh-btn" size="mini" bindtap="loadPortfolio">刷新</button>
    </view>

    <view class="upload-hint">已上传 {{items.length}} 张，支持继续上传、置顶和删除</view>

    <button
      class="upload-btn"
      bindtap="chooseAndUpload"
      disabled="{{!token || portfolioUploading}}"
    >
      {{portfolioUploading ? '上传中（' + portfolioUploadCount + '张）...' : '选择照片上传'}}
    </button>

    <view wx:if="{{lastUrl}}" class="upload-result">{{lastUrl}}</view>
    <view wx:if="{{pendingPortfolio.length > 0}}" class="upload-hint" style="margin-top: 10rpx;">
      待提交 {{pendingPortfolio.length}} 张，点击底部按钮后进入审核
    </view>
    <view class="portfolio-grid" wx:if="{{pendingPortfolio.length > 0}}">
      <view wx:for="{{pendingPortfolio}}" wx:key="tempFilePath" class="portfolio-cell">
        <image mode="aspectFill" src="{{item.tempFilePath}}" class="portfolio-thumb" />
        <view class="portfolio-actions">
          <text class="action-link pending-text">待上传</text>
          <text class="action-link danger" data-index="{{index}}" bindtap="removePendingPortfolio">移除</text>
        </view>
      </view>
    </view>

    <!-- 作品列表 - 网格展示 -->
    <view wx:if="{{portfolioLoading}}" class="cs-muted" style="padding-top: 16rpx;">加载中...</view>
    <view class="portfolio-grid" wx:if="{{items.length > 0}}">
      <view wx:for="{{items}}" wx:key="id" class="portfolio-cell">
        <image mode="aspectFill" src="{{item.display_url}}" class="portfolio-thumb" />
        <view class="portfolio-actions">
          <text
            class="action-link {{item.is_pinned ? 'pinned' : ''}}"
            data-id="{{item.id}}"
            bindtap="togglePin"
          >{{item.is_pinned ? '已置顶' : '置顶'}}</text>
          <text class="action-link danger" data-id="{{item.id}}" bindtap="deleteItem">删除</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!portfolioLoading && items.length===0}}" class="empty-hint">
      上传 3 张以上作品即可上线展示
    </view>
  </view>

  <!-- ========== STEP 3: 服务报价（精简） ========== -->
  <view class="cs-card" wx:if="{{authorized}}">
    <view class="card-header">
      <view class="card-title-row">
        <view class="step-badge">3</view>
        <text class="card-title">服务报价（可编辑）</text>
      </view>
      <button class="refresh-btn" size="mini" bindtap="loadPackages">刷新</button>
    </view>
    <view class="upload-hint">已配置 {{packages.length}} 个套餐。上方管理已有套餐，下方持续保留新增套餐编辑区。</view>

    <!-- 快速创建预设套餐 -->
    <view wx:if="{{packages.length === 0 && !showNewPackage}}" class="preset-section">
      <view class="preset-hint">一键创建标准套餐，快速上线</view>
      <view class="preset-list">
        <view
          wx:for="{{presetPackages}}"
          wx:key="name"
          class="preset-card"
          data-index="{{index}}"
          bindtap="applyPreset"
        >
          <view class="preset-name">{{item.name}}</view>
          <view class="preset-price">¥{{item.price_yuan}}</view>
          <view class="preset-desc">{{item.desc}}</view>
        </view>
      </view>
      <view class="preset-or">
        <view class="or-line"></view>
        <text class="or-text">或</text>
        <view class="or-line"></view>
      </view>
      <button class="text-btn" bindtap="showCustomPackage">自定义套餐</button>
    </view>

    <!-- 已有套餐列表 -->
    <view wx:if="{{packages.length > 0}}" class="pkg-section-head">
      <view class="pkg-section-title">已有套餐</view>
      <view class="pkg-section-desc">已保存的套餐会展示在这里，可继续修改、上下架或删除。</view>
    </view>
    <view wx:for="{{packages}}" wx:key="id" class="pkg-edit-card">
      <view class="pkg-edit-header">
        <input class="pkg-name-input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onPackageField" />
        <view class="pkg-price-tag">
          <text class="yuan">¥</text>
          <input class="pkg-price-input" type="digit" value="{{item.price_yuan}}" data-index="{{index}}" data-field="price_yuan" bindinput="onPackageField" />
        </view>
      </view>
      <view class="pkg-edit-row">
        <view class="pkg-field-group">
          <text class="pkg-field-label">时长</text>
          <input class="pkg-field-input" type="number" placeholder="分钟" value="{{item.duration_minutes}}" data-index="{{index}}" data-field="duration_minutes" bindinput="onPackageField" />
        </view>
        <view class="pkg-toggle">
          <text class="pkg-field-label">上架</text>
          <switch checked="{{item.is_active}}" data-index="{{index}}" data-field="is_active" bindchange="onPackageField" />
        </view>
      </view>
      <textarea
        class="pkg-desc-input"
        placeholder="套餐描述（选填）"
        value="{{item.description}}"
        data-index="{{index}}"
        data-field="description"
        bindinput="onPackageField"
      ></textarea>
      <view class="pkg-edit-actions">
        <button class="save-btn" size="mini" data-index="{{index}}" bindtap="savePackage">保存</button>
        <button class="delete-btn" size="mini" data-id="{{item.id}}" bindtap="deletePackage">删除</button>
      </view>
    </view>

    <!-- 新增套餐 -->
    <view wx:if="{{showNewPackage || packages.length > 0}}" class="new-pkg-section">
      <view class="divider"></view>
      <view class="pkg-section-head">
        <view class="pkg-section-title">新增套餐</view>
        <view class="pkg-section-desc">每次保存后，新的套餐会出现在上方，这里保留一个新的编辑框继续添加。</view>
      </view>
      <view class="pkg-edit-card new-pkg-form">
        <input class="input" placeholder="套餐名称" value="{{newPackage.name}}" data-field="name" bindinput="onNewPackageField" />
        <view class="row-2" style="margin-top: 10rpx;">
          <input class="input flex-1" type="digit" placeholder="价格（元）" value="{{newPackage.price_yuan}}" data-field="price_yuan" bindinput="onNewPackageField" />
          <input class="input flex-1" type="number" placeholder="时长（分钟）" value="{{newPackage.duration_minutes}}" data-field="duration_minutes" bindinput="onNewPackageField" />
        </view>
        <textarea
          class="textarea-sm"
          placeholder="套餐描述（选填）"
          value="{{newPackage.description}}"
          data-field="description"
          bindinput="onNewPackageField"
        ></textarea>
        <view class="row-actions">
          <button class="save-btn" size="mini" bindtap="addPackage">添加</button>
          <button class="cancel-btn" size="mini" bindtap="hideNewPackage">{{packages.length > 0 ? '清空' : '取消'}}</button>
        </view>
      </view>
    </view>
  </view>

  <view class="cs-card location-card" wx:if="{{authorized}}">
    <view class="location-soda-row">
      <view class="location-pill">
        <text class="location-pill-key">城市</text>
        <text class="location-pill-value">{{serviceCityText}}</text>
      </view>
      <view class="location-pill location-pill-coord">
        <text class="location-pill-key">坐标</text>
        <text class="location-pill-value">{{serviceCoordText}}</text>
      </view>
      <button
        class="location-refresh-btn location-refresh-soda-btn"
        bindtap="refreshServiceLocation"
        loading="{{locationRefreshing}}"
        disabled="{{!token || locationRefreshing}}"
      >{{locationRefreshing ? '刷新中' : '刷新'}}</button>
    </view>
  </view>

  <!-- ========== 档期管理（折叠） ========== -->
  <view class="cs-card" wx:if="{{authorized && showScheduleSection}}">
    <view class="card-header" bindtap="toggleScheduleExpanded">
      <view class="card-title-row">
        <text class="card-title">档期管理</text>
      </view>
      <text class="expand-text">{{scheduleExpanded ? '收起' : '展开'}}</text>
    </view>

    <view wx:if="{{scheduleExpanded}}">
      <view class="month-nav">
        <button class="nav-btn" size="mini" data-delta="-1" bindtap="changeMonth">上月</button>
        <view class="month-label">{{scheduleYear}}-{{scheduleMonth}}</view>
        <button class="nav-btn" size="mini" data-delta="1" bindtap="changeMonth">下月</button>
      </view>
      <view class="cs-week">
        <view>日</view><view>一</view><view>二</view><view>三</view><view>四</view><view>五</view><view>六</view>
      </view>
      <view class="cs-calendar">
        <view
          wx:for="{{scheduleCells}}"
          wx:key="index"
          class="cs-day {{item.status}}"
          data-date="{{item.date}}"
          bindtap="tapDay"
        >
          {{item.day}}
        </view>
      </view>
      <view class="cs-legend">
        <view class="cs-legend-item busy">忙碌</view>
        <view class="cs-legend-item blocked">不可约</view>
      </view>
    </view>
  </view>

  <view class="submit-upload-bar" wx:if="{{authorized}}">
    <button
      class="submit-upload-btn"
      bindtap="submitAllChanges"
      loading="{{portfolioUploading || submittingAll}}"
      disabled="{{!token || portfolioUploading || submittingAll || (!profileDraftSaved && pendingPortfolio.length === 0)}}"
    >
      {{(portfolioUploading || submittingAll) ? (portfolioUploadCount > 0 ? '提交中（' + portfolioUploadCount + '张）...' : '提交中...') : (profileDraftSaved || pendingPortfolio.length > 0 ? '提交审核（' + pendingPortfolio.length + '张作品）' : '提交审核')}}
    </button>
  </view>

  <view style="height: 250rpx;"></view>
</view>
