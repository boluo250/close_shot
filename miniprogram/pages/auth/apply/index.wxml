<view class="cs-page apply-page">

  <!-- 顶部进度条 -->
  <view class="progress-bar">
    <view class="progress-steps">
      <view class="progress-step {{step >= 1 ? 'active' : ''}}" bindtap="prevStep" data-step="1">
        <view class="step-dot {{step > 1 ? 'done' : ''}}">
          <text wx:if="{{step > 1}}">✓</text>
          <text wx:else>1</text>
        </view>
        <text class="step-label">实名认证</text>
      </view>
      <view class="progress-line {{step > 1 ? 'active' : ''}}"></view>
      <view class="progress-step {{step >= 2 ? 'active' : ''}}">
        <view class="step-dot {{step > 2 ? 'done' : ''}}">
          <text wx:if="{{step > 2}}">✓</text>
          <text wx:else>2</text>
        </view>
        <text class="step-label">摄影师身份</text>
      </view>
      <view class="progress-line {{step > 2 ? 'active' : ''}}"></view>
      <view class="progress-step {{step >= 3 ? 'active' : ''}}">
        <view class="step-dot">3</view>
        <text class="step-label">联系方式</text>
      </view>
    </view>
  </view>

  <!-- ===== Step 1: 实名认证 ===== -->
  <view class="step-content" wx:if="{{step === 1}}">
    <view class="cs-card">
      <view class="section-title">实名认证</view>
      <view class="section-desc">用于身份核实，信息仅平台内部可见</view>

      <view class="form-group">
        <view class="form-label">真实姓名 <text class="required">*</text></view>
        <input class="form-input"
               placeholder="请输入身份证上的姓名"
               value="{{realName}}"
               bindinput="onRealNameInput"
               maxlength="20" />
      </view>

      <view class="form-group">
        <view class="form-label">身份证号 <text class="required">*</text></view>
        <input class="form-input"
               placeholder="请输入18位身份证号"
               value="{{idCardNumber}}"
               bindinput="onIdCardInput"
               maxlength="18"
               type="idcard" />
      </view>

      <view class="form-group">
        <view class="form-label">身份证照片 <text class="required">*</text></view>
        <view class="id-card-upload">
          <view class="id-card-item" bindtap="chooseIdCardFront">
            <image wx:if="{{idCardFrontUrl}}"
                   src="{{idCardFrontUrl}}"
                   mode="aspectFill"
                   class="id-card-img"
                   bindtap="previewImage"
                   data-url="{{idCardFrontUrl}}" />
            <view wx:else class="id-card-placeholder">
              <text class="upload-icon">+</text>
              <text class="upload-text">人像面</text>
            </view>
          </view>
          <view class="id-card-item" bindtap="chooseIdCardBack">
            <image wx:if="{{idCardBackUrl}}"
                   src="{{idCardBackUrl}}"
                   mode="aspectFill"
                   class="id-card-img"
                   bindtap="previewImage"
                   data-url="{{idCardBackUrl}}" />
            <view wx:else class="id-card-placeholder">
              <text class="upload-icon">+</text>
              <text class="upload-text">国徽面</text>
            </view>
          </view>
        </view>
        <view class="form-tip">请确保照片清晰完整，信息不被遮挡</view>
      </view>
    </view>

    <view class="btn-area">
      <button class="cs-btn cs-btn-primary full-btn {{step1Valid ? '' : 'disabled'}}"
              bindtap="nextStep">
        下一步
      </button>
    </view>
  </view>

  <!-- ===== Step 2: 摄影师身份 ===== -->
  <view class="step-content" wx:if="{{step === 2}}">
    <view class="cs-card">
      <view class="section-title">摄影师身份</view>
      <view class="section-desc">帮助用户了解你的专业方向</view>

      <view class="form-group">
        <view class="form-label">拍摄类型 <text class="required">*</text></view>
        <view class="tag-grid">
          <view wx:for="{{shootingTypes}}" wx:key="*this"
                class="tag-item {{selectedTypes.indexOf(item) > -1 ? 'selected' : ''}}"
                bindtap="toggleShootingType"
                data-type="{{item}}">
            {{item}}
          </view>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">从业年限 <text class="required">*</text></view>
        <picker mode="selector"
                range="{{experienceOptions}}"
                value="{{experienceIndex}}"
                bindchange="onExperienceChange">
          <view class="form-input picker-input {{experienceYears ? '' : 'placeholder'}}">
            {{experienceYears || '请选择从业年限'}}
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <view class="form-label">个人摄影主页 <text class="optional">（选填）</text></view>
        <input class="form-input"
               placeholder="小红书/站酷/Instagram 链接"
               value="{{portfolioLink}}"
               bindinput="onPortfolioLinkInput"
               maxlength="200" />
        <view class="form-tip">有主页链接可加快审核速度</view>
      </view>
    </view>

    <view class="btn-area btn-area-row">
      <button class="cs-btn back-btn" bindtap="prevStep">上一步</button>
      <button class="cs-btn cs-btn-primary flex-btn {{step2Valid ? '' : 'disabled'}}"
              bindtap="nextStep">
        下一步
      </button>
    </view>
  </view>

  <!-- ===== Step 3: 联系方式 ===== -->
  <view class="step-content" wx:if="{{step === 3}}">
    <view class="cs-card">
      <view class="section-title">联系方式</view>
      <view class="section-desc">仅在用户下单后对双方可见</view>

      <view class="form-group">
        <view class="form-label">手机号 <text class="required">*</text></view>
        <input class="form-input"
               placeholder="请输入手机号"
               value="{{phone}}"
               bindinput="onPhoneInput"
               maxlength="11"
               type="number" />
      </view>

      <view class="form-group">
        <view class="form-label">微信号 <text class="required">*</text></view>
        <input class="form-input"
               placeholder="请输入微信号"
               value="{{wechatId}}"
               bindinput="onWechatInput"
               maxlength="32" />
        <view class="form-tip">仅展示给已下单的用户</view>
      </view>
    </view>

    <!-- 可选信息 -->
    <view class="cs-card" style="margin-top: 20rpx;">
      <view class="section-title">补充信息 <text class="optional">（选填）</text></view>

      <view class="form-group">
        <view class="form-label">常驻城市</view>
        <input class="form-input"
               placeholder="如：北京"
               value="{{city}}"
               bindinput="onCityInput"
               maxlength="20" />
      </view>

      <view class="form-group">
        <view class="form-label">报价区间</view>
        <picker mode="selector"
                range="{{priceRanges}}"
                value="{{priceRangeIndex}}"
                bindchange="onPriceRangeChange">
          <view class="form-input picker-input {{priceRange ? '' : 'placeholder'}}">
            {{priceRange ? '¥' + priceRange : '请选择报价区间'}}
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="btn-area btn-area-row">
      <button class="cs-btn back-btn" bindtap="prevStep">上一步</button>
      <button class="cs-btn cs-btn-primary flex-btn {{step3Valid ? '' : 'disabled'}}"
              bindtap="submitApply"
              disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交审核'}}
      </button>
    </view>

    <view class="submit-tip">
      提交后预计 1-24 小时内完成审核
    </view>
  </view>

</view>
