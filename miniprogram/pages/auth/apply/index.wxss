.apply-page {
  padding-bottom: 60rpx;
}

.status-card {
  margin: 24rpx;
}

.status-pending {
  background: linear-gradient(180deg, rgba(191, 232, 74, 0.14), rgba(255, 255, 255, 0.96));
}

.status-approved {
  background: linear-gradient(180deg, rgba(34, 197, 94, 0.12), rgba(255, 255, 255, 0.98));
}

.status-rejected {
  border: 2rpx solid rgba(231, 76, 60, 0.14);
}

.status-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--cs-color-text, #111827);
}

.status-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--cs-color-muted, #8a8f98);
  line-height: 1.6;
}

.status-reason {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(231, 76, 60, 0.08);
  color: #b5473a;
  font-size: 24rpx;
  line-height: 1.6;
}

.status-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ========== 进度条 ========== */
.progress-bar {
  padding: 30rpx 24rpx 20rpx;
}

.progress-steps {
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--cs-color-border, #eef0f3);
  color: var(--cs-color-muted, #8a8f98);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  transition: all 0.3s;
}

.progress-step.active .step-dot {
  background: var(--cs-color-primary, #bfe84a);
  color: #111;
}

.step-dot.done {
  background: var(--cs-color-primary, #bfe84a);
  color: #111;
}

.step-label {
  font-size: 22rpx;
  color: var(--cs-color-muted, #8a8f98);
  white-space: nowrap;
}

.progress-step.active .step-label {
  color: var(--cs-color-text, #111827);
  font-weight: 500;
}

.progress-line {
  width: 80rpx;
  height: 4rpx;
  background: var(--cs-color-border, #eef0f3);
  margin: 0 16rpx;
  margin-bottom: 30rpx;
  border-radius: 2rpx;
  transition: background 0.3s;
}

.progress-line.active {
  background: var(--cs-color-primary, #bfe84a);
}

/* ========== 步骤内容 ========== */
.step-content {
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ========== 区块标题 ========== */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--cs-color-text, #111827);
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 24rpx;
  color: var(--cs-color-muted, #8a8f98);
  margin-bottom: 28rpx;
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: var(--cs-color-text, #111827);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.required {
  color: #e74c3c;
  margin-left: 4rpx;
}

.optional {
  color: var(--cs-color-muted, #8a8f98);
  font-size: 22rpx;
  font-weight: 400;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--cs-color-surface-2, rgba(255, 255, 255, 0.10));
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--cs-color-text, #111827);
  box-sizing: border-box;
  border: 2rpx solid var(--cs-color-border, rgba(255, 255, 255, 0.12));
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: var(--cs-color-primary, #bfe84a);
  background: rgba(255, 255, 255, 0.14);
}

.form-tip {
  font-size: 22rpx;
  color: var(--cs-color-muted, #8a8f98);
  margin-top: 8rpx;
}

/* ========== 简介模板 ========== */
.bio-tpl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 12rpx 0 12rpx;
}

.bio-tpl {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.06);
  border: 2rpx solid rgba(17, 24, 39, 0.10);
  color: var(--cs-color-text, #111827);
  font-size: 24rpx;
  max-width: 100%;
}

.bio-tpl.active {
  background: rgba(191, 232, 74, 0.15);
  border-color: var(--cs-color-primary, #bfe84a);
  color: #5a7a00;
  font-weight: 500;
}

/* ========== 扩展表单控件 ========== */
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--cs-color-surface-2, rgba(255, 255, 255, 0.10));
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: var(--cs-color-text, #111827);
  box-sizing: border-box;
  border: 2rpx solid var(--cs-color-border, rgba(255, 255, 255, 0.12));
}

.form-textarea:focus {
  border-color: var(--cs-color-primary, #bfe84a);
  background: rgba(255, 255, 255, 0.14);
}

.form-placeholder {
  color: var(--cs-color-text-3, rgba(248, 250, 252, 0.42));
}

.avatar-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.avatar-slot {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f8f9fb;
  border: 2rpx dashed var(--cs-color-border, #eef0f3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: var(--cs-color-muted, #8a8f98);
}

.placeholder-plus {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(191, 232, 74, 0.18);
  color: #5a7a00;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.placeholder-text {
  font-size: 22rpx;
}

.avatar-tip {
  flex: 1;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(191, 232, 74, 0.12);
  border: 2rpx solid rgba(191, 232, 74, 0.45);
  color: #5a7a00;
  font-size: 24rpx;
}

.chip-alt {
  background: rgba(17, 24, 39, 0.06);
  border-color: rgba(17, 24, 39, 0.12);
  color: var(--cs-color-text, #111827);
}

.chip-x {
  color: rgba(0, 0, 0, 0.55);
  font-size: 28rpx;
  line-height: 1;
}

.input-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.mini-btn {
  border-radius: 999rpx;
  background: var(--cs-color-surface-2, rgba(255, 255, 255, 0.10));
  border: 2rpx solid var(--cs-color-border, rgba(255, 255, 255, 0.12));
  color: var(--cs-color-text, #f8fafc);
  font-size: 24rpx;
  padding: 12rpx 18rpx;
  line-height: 1.2;
}

.mini-btn::after {
  border: none;
}

.mini-btn.wide {
  width: 100%;
  margin-top: 12rpx;
}

.row-2 {
  display: flex;
  gap: 12rpx;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.switch-label {
  font-size: 26rpx;
  color: var(--cs-color-text, #111827);
}

.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.location-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--cs-color-text-2, #525866);
}

.draft-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.draft-cell {
  width: 216rpx;
  height: 216rpx;
  border-radius: 14rpx;
  overflow: hidden;
  position: relative;
  background: #f8f9fb;
}

.draft-img {
  width: 100%;
  height: 100%;
}

.draft-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: rgba(17, 24, 39, 0.55);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.draft-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.draft-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f8f9fb;
}

.draft-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.draft-title {
  font-size: 26rpx;
  color: var(--cs-color-text, #111827);
  font-weight: 600;
  flex: 1;
}

.draft-badge {
  font-size: 22rpx;
  color: var(--cs-color-muted, #8a8f98);
  background: rgba(17, 24, 39, 0.06);
  border: 2rpx solid rgba(17, 24, 39, 0.10);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.draft-sub {
  font-size: 24rpx;
  color: var(--cs-color-muted, #8a8f98);
}

.draft-link {
  font-size: 24rpx;
  color: #409eff;
}

.draft-link.danger {
  color: #e74c3c;
}

/* ========== Picker ========== */
.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  line-height: 80rpx;
}

.picker-input.placeholder {
  color: #c0c4cc;
}

.picker-arrow {
  font-size: 32rpx;
  color: #c0c4cc;
  transform: rotate(0deg);
}

/* ========== 标签选择 ========== */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #f8f9fb;
  color: var(--cs-color-text, #111827);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-item.selected {
  background: rgba(191, 232, 74, 0.15);
  border-color: var(--cs-color-primary, #bfe84a);
  color: #5a7a00;
  font-weight: 500;
}

.tag-item.disabled {
  opacity: 0.45;
}

/* ========== 按钮区域 ========== */
.btn-area {
  padding: 30rpx 0 0;
}

.btn-area-row {
  display: flex;
  gap: 20rpx;
}

.full-btn {
  width: 100%;
}

.flex-btn {
  flex: 1;
}

.back-btn {
  width: 200rpx;
  background: var(--cs-color-surface-2, rgba(255, 255, 255, 0.10));
  border: 2rpx solid var(--cs-color-border, rgba(255, 255, 255, 0.12));
  color: var(--cs-color-text, #f8fafc);
}

.cs-btn-primary {
  background: var(--cs-color-primary, #bfe84a);
  border-color: var(--cs-color-primary, #bfe84a);
  color: #111;
  font-weight: 600;
}

.cs-btn-primary.disabled {
  opacity: 0.5;
}

.cs-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: none;
  line-height: 1.4;
}

.cs-btn::after {
  border: none;
}

.submit-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--cs-color-muted, #8a8f98);
  padding-top: 20rpx;
}
