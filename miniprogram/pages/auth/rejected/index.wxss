.rejected-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.status-icon {
  text-align: center;
  margin-bottom: 20rpx;
}

.icon-emoji {
  font-size: 80rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  color: var(--cs-color-text, #111827);
  margin-bottom: 24rpx;
}

.reason-box {
  background: #fff5f5;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.reason-label {
  font-size: 24rpx;
  color: #e74c3c;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.reason-text {
  font-size: 26rpx;
  color: #c0392b;
  line-height: 1.6;
}

.tips {
  padding-top: 20rpx;
  border-top: 1rpx solid var(--cs-color-border, #eef0f3);
}

.tip-title {
  font-size: 24rpx;
  color: var(--cs-color-muted, #8a8f98);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.tip-item {
  font-size: 24rpx;
  color: var(--cs-color-muted, #8a8f98);
  line-height: 1.8;
}

/* 按钮组 */
.btn-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  padding: 30rpx 0;
}

.flex-btn {
  width: 100%;
}

.cs-btn-primary {
  background: var(--cs-color-primary, #bfe84a);
  border-color: var(--cs-color-primary, #bfe84a);
  color: #111;
  font-weight: 600;
}

.cs-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.4;
}
