<view class="cs-page review-page">
  <view class="cs-card">
    <!-- 状态图标 -->
    <view class="status-icon">
      <text class="icon-emoji">⏳</text>
    </view>

    <view class="status-title">审核中</view>
    <view class="status-desc">
      你的入驻资料已提交，预计 1-24 小时内完成审核。
    </view>

    <!-- 认证进度 -->
    <view class="cert-checklist">
      <view class="check-item">
        <text class="check-icon {{identityVerified ? 'done' : ''}}">{{identityVerified ? '✓' : '○'}}</text>
        <text class="check-text">实名认证</text>
      </view>
      <view class="check-item">
        <text class="check-icon {{portfolioUploaded ? 'done' : ''}}">{{portfolioUploaded ? '✓' : '○'}}</text>
        <text class="check-text">资料完善</text>
      </view>
      <view class="check-item">
        <text class="check-icon {{contactVerified ? 'done' : ''}}">{{contactVerified ? '✓' : '○'}}</text>
        <text class="check-text">联系方式</text>
      </view>
    </view>

    <view class="cert-level" wx:if="{{certLevel > 0}}">
      当前认证等级：Lv{{certLevel}}
    </view>
  </view>

  <view class="btn-group">
    <button class="cs-btn" bindtap="onRefresh">刷新状态</button>
    <button class="cs-btn" bindtap="onBackMine">返回我的</button>
  </view>

  <view class="review-tip">
    如需加急审核，请联系平台客服
  </view>
</view>
