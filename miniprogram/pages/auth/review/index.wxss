.review-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.status-icon {
  text-align: center;
  margin-bottom: 20rpx;
}

.icon-emoji {
  font-size: 80rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  color: var(--cs-color-text, #111827);
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 26rpx;
  color: var(--cs-color-muted, #8a8f98);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

/* 认证进度清单 */
.cert-checklist {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--cs-color-border, #eef0f3);
}

.check-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f0f1f3;
  color: #c0c4cc;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 40rpx;
  text-align: center;
}

.check-icon.done {
  background: rgba(191, 232, 74, 0.2);
  color: #5a7a00;
}

.check-text {
  font-size: 28rpx;
  color: var(--cs-color-text, #111827);
}

.cert-level {
  text-align: center;
  font-size: 24rpx;
  color: var(--cs-color-primary, #bfe84a);
  font-weight: 500;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--cs-color-border, #eef0f3);
  margin-top: 8rpx;
}

/* 按钮组 */
.btn-group {
  display: flex;
  gap: 20rpx;
  width: 100%;
  padding: 30rpx 0;
}

.btn-group .cs-btn {
  flex: 1;
}

.review-tip {
  font-size: 22rpx;
  color: var(--cs-color-muted, #8a8f98);
  text-align: center;
}
