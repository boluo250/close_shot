<view class="cs-page">
  <view class="cs-card">
    <view class="cs-row">
      <view><text style="font-weight: 600">我的</text></view>
      <button class="cs-btn" size="mini" bindtap="refresh">刷新</button>
    </view>
    <view class="cs-muted" style="padding-top: 10rpx;">
      {{token ? '已登录（微信登录）' : '未登录'}}
    </view>

    <view style="height: 12rpx;"></view>

    <view wx:if="{{!token}}">
      <button class="cs-btn cs-btn-primary" style="margin-top: 12rpx;" bindtap="login" disabled="{{loading}}">
        {{loading ? '登录中...' : '一键登录'}}
      </button>
      <view class="cs-muted" style="padding-top: 10rpx;">
        会调用后端 `/auth/wechat` 换取 token，用于“收藏/我的”相关接口。
      </view>
    </view>
    <view wx:else>
      <button class="cs-btn" style="margin-top: 12rpx;" bindtap="logout">退出登录</button>
    </view>
  </view>

  <view style="height: 16rpx;"></view>

  <view class="cs-card">
    <view><text style="font-weight: 600">快捷入口</text></view>
    <view style="height: 12rpx;"></view>
    <view style="display:flex; gap: 12rpx; flex-wrap: wrap;">
      <button class="cs-btn" bindtap="goFavorites">我的收藏</button>
      <view class="cs-studio-entry">
        <button class="cs-btn" bindtap="goStudio">摄影师工作台</button>
        <view
          wx:if="{{photographerStatus !== 'approved'}}"
          class="cs-badge {{photographerStatus}}"
        >
          {{identityLoading ? '查询中' : (photographerStatus === 'pending' ? '待认证' : photographerStatus === 'rejected' ? '已驳回' : '申请入驻')}}
        </view>
      </view>
    </view>
    <view class="cs-muted" style="padding-top: 10rpx;">
      工作台用于摄影师上传作品（偏内部工具，先放在这里不进主 Tab）。
    </view>
  </view>
</view>

