<view class="page">
  <!-- ① 顶部区：轻、干净、不像工具 -->
  <view class="top">
    <view class="top-row">
      <view class="loc" bindtap="onTapCity">
        <text class="loc-icon">📍</text>
        <text class="loc-text">{{cityText}}</text>
      </view>
      <view class="search" bindtap="onTapSearch">🔍</view>
    </view>
    <view class="subtitle">这附近，谁拍得好？</view>
  </view>

  <!-- ② 地图区：退居二线 -->
  <view class="map-wrap">
    <map
      id="map"
      longitude="{{lng}}"
      latitude="{{lat}}"
      scale="{{scale}}"
      markers="{{markers}}"
      circles="{{circles}}"
      show-location
      enable-rotate="false"
      enable-overlooking="false"
      style="width: 100%; height: 38vh;"
      bindmarkertap="onMarkerTap"
      bindregionchange="onRegionChange"
    />
    <view class="map-hint cs-muted">位置为服务范围，并非实时定位</view>
    <view wx:if="{{markerOverflow}}" class="map-badge">点位较多，已简化展示</view>
  </view>

  <!-- ③ 摄影师卡片区：首页核心 -->
  <view class="cs-page" style="padding-top: 0;">
    <view class="section-row">
      <view class="section-title">附近摄影师</view>
      <button class="cs-btn" size="mini" bindtap="refresh">刷新</button>
    </view>

    <view wx:if="{{loading}}" class="cs-muted" style="padding-top: 10rpx;">加载中...</view>
  <view wx:if="{{errorText}}" class="cs-muted" style="padding-top: 10rpx;">{{errorText}}</view>

    <view
      wx:for="{{list}}"
      wx:key="id"
      class="p-card {{selected && selected.id===item.id ? 'p-card-active' : ''}}"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="p-top">
        <image
          class="avatar"
          mode="aspectFill"
          src="{{item.avatar_url || ''}}"
          style="{{item.avatar_url ? '' : 'background:#eef0f3;'}}"
        />
        <view class="p-meta">
          <view class="p-name-row">
            <text class="p-name">{{item.display_name}}</text>
            <text class="p-price" wx:if="{{item.starting_price_yuan}}">¥{{item.starting_price_yuan}} 起</text>
            <text class="p-price p-price-muted" wx:else>价格面议</text>
          </view>

          <view class="p-intro {{item.bio ? '' : 'cs-muted'}}">
            {{item.bio || '暂无简介'}}
          </view>

          <!-- 底部信息：固定贴底，保证价格对齐 -->
          <view class="p-footer">
            <view class="p-brief">
              <text class="cs-muted">作品集 {{item.portfolio_count || 0}} 张</text>
              <text class="cs-muted" wx:if="{{item.rate_copy}}"> · {{item.rate_copy}}</text>
            </view>

            <view class="p-subrow">
              <text class="cs-muted">{{item.distance_copy}}</text>
            </view>
          </view>
        </view>
      </view>

      <scroll-view class="shots" scroll-x enhanced show-scrollbar="{{false}}">
        <image
          wx:for="{{item.preview_image_urls}}"
          wx:for-item="u"
          wx:key="u"
          class="shot"
          mode="aspectFill"
          lazy-load
          src="{{u}}"
        />
        <view wx:if="{{item.preview_empty}}" class="shot ph">
          <text class="cs-muted">暂无样片</text>
        </view>
      </scroll-view>
    </view>

    <!-- ④ 空状态（年轻版） -->
    <view wx:if="{{!loading && list.length===0}}" class="empty">
      <view class="empty-title">🌆 这个点有点安静</view>
      <view class="cs-muted" style="padding-top: 10rpx;">试试放大地图，或换个时间看看</view>
      <view class="cs-muted" style="padding-top: 6rpx;">晚上和周末更容易约到摄影师哦</view>
    </view>
  </view>

  <view wx:if="{{selected}}" class="sheet-mask" bindtap="closeSelected"></view>
  <view wx:if="{{selected}}" class="sheet">
    <view class="sheet-header">
      <view class="sheet-title">{{selected.display_name}}</view>
      <view class="sheet-close" bindtap="closeSelected">关闭</view>
    </view>
    <view class="sheet-meta cs-muted">{{selected.distance_copy}}</view>
    <view class="sheet-meta">
      <text wx:if="{{selected.starting_price_yuan}}">¥{{selected.starting_price_yuan}} 起</text>
      <text wx:else>价格面议</text>
      <text class="cs-muted"> · 作品 {{selected.portfolio_count || 0}} 张</text>
    </view>
    <view class="sheet-actions">
      <button class="sheet-btn ghost" bindtap="goDetailSelected">查看主页</button>
      <button class="sheet-btn ghost" bindtap="contactSelected">联系摄影师</button>
      <button class="sheet-btn primary" bindtap="bookSelected">预约拍摄</button>
    </view>
  </view>

  <!-- ⑤ 主 CTA（悬浮按钮） -->
  <view class="cta-wrap">
    <button class="cta" bindtap="onShootCTA">📸 我要拍照</button>
  </view>
</view>

