<view class="page">
  <!-- 顶部区 -->
  <view class="top">
    <view class="top-row">
      <view class="loc" bindtap="onTapCity">
        <text class="loc-icon">📍</text>
        <text class="loc-text">{{cityText}}</text>
      </view>
      <view class="search" bindtap="onTapSearch">🔍</view>
    </view>
    <view class="subtitle">这附近，谁拍得好？</view>
  </view>

  <!-- 地图区 -->
  <view class="map-wrap">
    <map
      id="map"
      longitude="{{lng}}"
      latitude="{{lat}}"
      scale="14"
      markers="{{markers}}"
      circles="{{circles}}"
      show-location
      enable-rotate="false"
      enable-overlooking="false"
      style="width: 100%; height: 38vh;"
      bindmarkertap="onMarkerTap"
    />
    <view class="map-hint cs-muted">位置为服务范围，并非实时定位</view>
  </view>

  <!-- 摄影师卡片区 -->
  <view class="cs-page" style="padding-top: 0;">
    <view class="section-row">
      <view class="section-title">附近摄影师</view>
      <button class="cs-btn" size="mini" bindtap="refresh">刷新</button>
    </view>
    <photographer-card-list
      list="{{list}}"
      loading="{{loading}}"
      errorText="{{errorText}}"
      source="nearby"
      emptyTitle="🌆 这个点有点安静"
      emptyDesc="试试放大地图，或换个时间看看"
    />
  </view>

  <!-- 主 CTA（悬浮按钮） -->
  <view class="cta-wrap">
    <button class="cta" bindtap="onShootCTA">📸 我要拍照</button>
  </view>
</view>

