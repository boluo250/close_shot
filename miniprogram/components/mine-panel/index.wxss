.cs-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.mine-page {
  min-height: 100vh;
  background: #000000;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.safe-top {
  height: 96rpx;
}

.mine-header-card {
  border-radius: 40rpx;
  padding: 36rpx 28rpx;
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.35);
}

.mine-head {
  display: flex;
  align-items: center;
}

.mine-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  flex-shrink: 0;
}

.mine-head-copy {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.mine-title {
  font-size: 48rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: #ffffff;
}

.mine-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mine-vip-badge {
  height: 44rpx;
  padding: 0 18rpx;
  line-height: 44rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3f2900;
  background: linear-gradient(120deg, #fff6cf 0%, #efd28b 48%, #b98a3a 100%);
  border: 1rpx solid rgba(255, 236, 180, 0.7);
  box-shadow: 0 8rpx 18rpx rgba(185, 138, 58, 0.35);
}

.mine-status-row {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mine-status-pill {
  height: 44rpx;
  padding: 0 16rpx;
  line-height: 44rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.1);
}

.mine-stats-card {
  margin-top: 32rpx;
  border-radius: 40rpx;
  padding: 34rpx 18rpx;
  display: flex;
  align-items: stretch;
  background: linear-gradient(150deg, #151515 0%, #0d0d0d 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 22rpx 44rpx rgba(0, 0, 0, 0.42);
}

.mine-stats-item {
  flex: 1;
  text-align: center;
  padding: 6rpx 8rpx;
}

.mine-stats-label {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8a;
}

.mine-stats-value {
  margin-top: 10rpx;
  font-size: 72rpx;
  line-height: 78rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: "DIN Alternate", "Bebas Neue", Arial, sans-serif;
  letter-spacing: 1rpx;
}

.mine-stats-btn {
  margin-top: 16rpx;
  display: inline-block;
  min-width: 132rpx;
  height: 50rpx;
  line-height: 50rpx;
  border-radius: 25rpx;
  font-size: 22rpx;
  color: #d1d5db;
  background: rgba(255, 255, 255, 0.08);
}

.mine-stats-btn.primary {
  color: #0c0c0c;
  background: #22c55e;
  font-weight: 700;
}

.mine-stats-divider {
  width: 1rpx;
  margin: 16rpx 0;
  background: rgba(255, 255, 255, 0.09);
}

.mine-cell-group {
  margin-top: 34rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.mine-cell {
  width: 100%;
  min-height: 130rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  background: transparent;
  border-radius: 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.mine-cell:last-child {
  border-bottom: 0;
}

.mine-cell::after {
  border: 0;
}

.mine-cell-hover {
  background: rgba(255, 255, 255, 0.1);
}

.mine-cell-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mine-cell-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mine-cell-title-strong {
  color: #ffffff;
  font-weight: 700;
}

.mine-membership-badge {
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 17rpx;
  background: rgba(34, 197, 94, 0.2);
  border: 1rpx solid rgba(74, 222, 128, 0.45);
  color: #86efac;
  font-size: 20rpx;
  font-weight: 700;
}

.mine-cell-title {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #f4f4f4;
}

.mine-cell-desc {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #7f7f7f;
}

.mine-cell-membership {
  background: linear-gradient(120deg, rgba(34, 197, 94, 0.14) 0%, rgba(20, 20, 20, 0.65) 65%);
  border-bottom-color: rgba(74, 222, 128, 0.24);
}

.mine-skeleton-card {
  border-color: rgba(255, 255, 255, 0.06);
}

.mine-skeleton-block,
.mine-skeleton-line,
.mine-skeleton-pill,
.mine-skeleton-btn {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0.06) 100%);
  background-size: 200% 100%;
  animation: mineShimmer 1.2s ease-in-out infinite;
}

.mine-skeleton-title {
  width: 220rpx;
  height: 44rpx;
  border-radius: 10rpx;
}

.mine-skeleton-pill {
  width: 140rpx;
}

.mine-skeleton-cell-title {
  width: 180rpx;
  height: 36rpx;
  border-radius: 8rpx;
}

.mine-skeleton-cell-desc {
  width: 340rpx;
  height: 30rpx;
  border-radius: 8rpx;
}

.mine-skeleton-btn {
  min-width: 132rpx;
  height: 58rpx;
  border-radius: 30rpx;
}

.mine-skeleton-arrow {
  width: 24rpx;
  height: 24rpx;
  border-radius: 8rpx;
}

@keyframes mineShimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.mine-membership-cta {
  min-width: 132rpx;
  height: 58rpx;
  padding: 0 20rpx;
  line-height: 58rpx;
  border-radius: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #0b0d12;
  font-weight: 700;
  background: var(--cs-gradient-primary);
  box-shadow: var(--cs-shadow-glow);
}

.cs-theme-classic .mine-membership-cta {
  color: #111827;
}

.mine-cell-arrow {
  width: 34rpx;
  text-align: right;
  font-size: 36rpx;
  line-height: 36rpx;
  color: #5e5e5e;
}

.mine-reject-tip {
  margin: 0 28rpx 24rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #f87171;
  background: rgba(248, 113, 113, 0.12);
  border: 1rpx solid rgba(248, 113, 113, 0.2);
}

.mine-login-wrap {
  margin-top: 26rpx;
}

.mine-login-btn {
  width: 100%;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  padding: 22rpx;
  color: #0c0c0c;
  font-size: 30rpx;
  font-weight: 700;
  background: #22c55e;
}

.mine-login-btn::after {
  border: 0;
}

.mine-login-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #7f7f7f;
  text-align: center;
}

.mine-logout-link {
  margin-top: 56rpx;
  margin-bottom: 18rpx;
  text-align: center;
  color: #666666;
  font-size: 26rpx;
  line-height: 40rpx;
}

.mine-debug-link {
  margin-top: 12rpx;
  margin-bottom: 18rpx;
  text-align: center;
  color: #f59e0b;
  font-size: 24rpx;
  line-height: 36rpx;
}

.tap-hover {
  opacity: 0.86;
}

