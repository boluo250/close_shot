APP_NAME=close-shot-api
ENV=dev

DATABASE_URL=postgresql+psycopg://close_shot:close_shot@localhost:5432/close_shot

JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=10080

# Storage
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=close-shot
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/close-shot

# WeChat Mini Program login
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_LOGIN_ALLOW_MOCK=false
WECHAT_MOCK_OPENID_SEED=local-dev

# Membership payment callback security token
MEMBERSHIP_CALLBACK_SECRET=dev-membership-callback

# Analytics daily report (run by cron at night)
ANALYTICS_REPORT_TIMEZONE=Asia/Shanghai
ANALYTICS_DAILY_REPORT_WEBHOOK_URL=
ANALYTICS_DAILY_REPORT_WEBHOOK_SECRET=

