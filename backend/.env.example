APP_NAME=close-shot-api
ENV=dev
# 可选：显式指定配置文件路径（例如 .env / .env.develop）
# ENV_FILE=.env.develop

DATABASE_URL=postgresql+psycopg://close_shot:close_shot@localhost:5432/close_shot

JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=10080

# Storage
STORAGE_BACKEND=s3
# 腾讯云 COS（S3 兼容）
S3_ENDPOINT_URL=https://cos.ap-shanghai.myqcloud.com
S3_ACCESS_KEY_ID=your-secret-id
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=bianpai-1256560950
S3_REGION=ap-shanghai
S3_PUBLIC_BASE_URL=https://your-bucket-appid.cos.ap-shanghai.myqcloud.com
STORAGE_SOFT_DELETE_ENABLED=true
STORAGE_SOFT_DELETE_PREFIX=_recycle_bin

# WeChat Mini Program login
WECHAT_APPID=wx8acda328b6212c0e
# 生产环境必须填写真实小程序密钥；为空时真机 wx.login -> /auth/wechat 会失败
WECHAT_SECRET=
WECHAT_LOGIN_ALLOW_MOCK=false
WECHAT_MOCK_OPENID_SEED=local-dev
# 订阅消息模板建议：
# 1) 摄影师新预约提醒：预约提醒通知
#    字段：thing1(预约内容) / date7(预约时间) / thing4(地点) / thing9(温馨提示)
# 2) 用户预约确认通知：预约成功通知
#    字段：thing1(预约服务) / date3(开始时间) / thing10(地址) / time14(预约时间)
# 3) 用户完单提醒：订单完成通知
#    字段：thing12(订单内容) / time16(完成时间) / thing5(备注信息) / time4(服务时间)
WECHAT_SUBSCRIBE_MINIPROGRAM_STATE=formal
WECHAT_SUBSCRIBE_PHOTOGRAPHER_NEW_APPOINTMENT_TEMPLATE_ID=
WECHAT_SUBSCRIBE_CUSTOMER_APPOINTMENT_ACCEPTED_TEMPLATE_ID=
WECHAT_SUBSCRIBE_CUSTOMER_APPOINTMENT_COMPLETED_TEMPLATE_ID=

# Membership payment callback security token
MEMBERSHIP_CALLBACK_SECRET=dev-membership-callback

# Analytics daily report (run by cron at night)
ANALYTICS_REPORT_TIMEZONE=Asia/Shanghai
ANALYTICS_DAILY_REPORT_WEBHOOK_URL=
ANALYTICS_DAILY_REPORT_WEBHOOK_SECRET=

# Operation log cleanup (run by cron, support dry-run verification before enabling deletion)
ADMIN_OPERATION_LOG_RETENTION_DAYS=180
USER_OPERATION_LOG_RETENTION_DAYS=90
OPERATION_LOG_CLEANUP_BATCH_SIZE=1000
