APP_NAME=close-shot-api
ENV=dev
# 可选：显式指定配置文件路径（例如 .env / .env.develop）
# ENV_FILE=.env.develop

DATABASE_URL=postgresql+psycopg://close_shot:close_shot@localhost:5432/close_shot

JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=10080

# Storage
STORAGE_BACKEND=s3
# 腾讯云 COS（S3 兼容）
S3_ENDPOINT_URL=https://cos.ap-shanghai.myqcloud.com
S3_ACCESS_KEY_ID=your-secret-id
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=bianpai-1256560950
S3_REGION=ap-shanghai
S3_PUBLIC_BASE_URL=https://your-bucket-appid.cos.ap-shanghai.myqcloud.com

# WeChat Mini Program login
WECHAT_APPID=wx8acda328b6212c0e
WECHAT_SECRET=
WECHAT_LOGIN_ALLOW_MOCK=false
WECHAT_MOCK_OPENID_SEED=local-dev

# Membership payment callback security token
MEMBERSHIP_CALLBACK_SECRET=dev-membership-callback

# Analytics daily report (run by cron at night)
ANALYTICS_REPORT_TIMEZONE=Asia/Shanghai
ANALYTICS_DAILY_REPORT_WEBHOOK_URL=
ANALYTICS_DAILY_REPORT_WEBHOOK_SECRET=

